# ── Supabase ──────────────────────────────────────────────────────────────────
# Required: Project URL and public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required: Service role key (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URLs ──────────────────────────────────────────────────────────────────
# Required: Canonical app URL — used for OAuth/email redirect URLs in auth flows
NEXT_PUBLIC_SITE_URL=https://app.qorvari.com

# Required: Same URL — used for Next.js metadataBase (Open Graph / canonical tags)
NEXT_PUBLIC_APP_URL=https://app.qorvari.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional: API key for sending contact form emails via Resend
RESEND_API_KEY=re_your_api_key

# Optional: Destination address for contact form submissions
CONTACT_EMAIL=hello@qorvari.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Optional: Pino log level (trace | debug | info | warn | error | fatal). Default: info
LOG_LEVEL=info
